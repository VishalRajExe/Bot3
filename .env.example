# BTC/USDT research & paper-trading system
#
# This system never submits real exchange orders and does not require any
# exchange credentials.  The only network access is read-only public
# market-data endpoints.  Do not paste API keys or private keys here: there is
# no live-trading code path that could use them.

# Optional: override the config file location
# BTCBOT_CONFIG=/absolute/path/to/config.json

# Optional: override the HTTP port for the dashboard/API
# BTCBOT_PORT=8601

# Optional: override the SQLite database location
# BTCBOT_DB=data/btcbot.sqlite3

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
# BTCBOT_LOG_LEVEL=INFO
